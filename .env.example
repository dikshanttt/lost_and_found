# Copy this file to .env and set values for your environment.
DB_HOST=localhost
DB_NAME=lost_found_hub
DB_USER=root
DB_PASSWORD=
APP_KEY=replace-with-a-random-64-character-secret
# Optional URL prefix when serving from a subfolder, for example /LostAndFound/public.
# Leave blank to detect it from the current request.
APP_BASE_PATH=

# SMTP settings for PHPMailer. Use your SMTP provider's credentials.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=LostAndFound
ADMIN_NOTIFICATION_EMAIL=admin@example.com
# Site origin only; the app adds the detected public-folder URL path.
APP_BASE_URL=http://localhost:8000

# First-run administrator account. Choose a unique password and delete these
# values after config/setup.php has created the administrator.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
